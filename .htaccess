# Never serve sensitive files: .env (admin password and API token), the database
# including SQLite's temporary -journal/-wal/-shm files, logs and Composer files.
#
# The database patterns are deliberately NOT anchored with `$`. An end-anchored
# `\.sqlite$` misses anything with a suffix after it - `rtls.sqlite.backup-20260524`
# was served as a plain static download, i.e. the whole database to anyone who
# guessed the name. Matching the extension anywhere in the filename covers dated
# backups, editor `.swp`/`~` leftovers and copies like `rtls.sqlite.old`.
<FilesMatch "(^\.env|\.(sql|sqlite|db)($|[.-])|\.log($|[.-])|^composer\.(json|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        order deny,allow
        deny from all
    </IfModule>
</FilesMatch>

RewriteEngine On

RewriteRule ^dbadmin/?$ dbadmin/index.php [QSA,L]
RewriteRule ^$ src/index.php [QSA,L]

# Serve existing files (CSS, JS) directly, send everything else to the application.
# The conditions must sit immediately before the rule they belong to.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ src/index.php [QSA,L]

# Pass the Authorization header through to PHP, otherwise Basic Auth does not work.
CGIPassAuth On
