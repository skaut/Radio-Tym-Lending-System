# Copy this file to `.env` on the server and fill in the real values.
# Without a `.env` file the application refuses to start.
#
# `.env` is gitignored and must stay that way - it was tracked in git until
# commit "chore: stop tracking .env, database and logs". Any password or token
# used before that point is still readable in the repository history, so treat
# those as compromised and set fresh ones below.

# Login to the whole administration (HTTP Basic Auth).
# CHANGE THIS! It protects the radio list, management and /dbadmin.
AUTH_USER='radio'
AUTH_PASS='change-me-to-a-strong-password'

# Require HTTPS before accepting the Basic Auth password.
# Basic Auth resends the password on every request, so on plain HTTP anyone on the
# same network can read it. Set this to true wherever the site has a certificate.
# localhost is always exempt so local development keeps working.
AUTH_REQUIRE_HTTPS=false

# Token for POST /api/voice-command (voice assistant).
# Leave empty to disable the API - it then always returns 401.
API_TOKEN=''

# Show error details including stack traces directly in the page.
# Keep false in production - the /public/{radioId} page is publicly accessible.
DEBUG=false
