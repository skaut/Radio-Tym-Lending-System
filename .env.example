# Copy this file to `.env` on the server and fill in the real values.
# Without a `.env` file the application refuses to start.

# Login to the whole administration (HTTP Basic Auth).
# CHANGE THIS! It protects the radio list, management and /dbadmin.
AUTH_USER='radio'
AUTH_PASS='change-me-to-a-strong-password'

# Token for POST /api/voice-command (voice assistant).
# Leave empty to disable the API - it then always returns 401.
API_TOKEN=''

# Show error details including stack traces directly in the page.
# Keep false in production - the /public/{radioId} page is publicly accessible.
DEBUG=false
